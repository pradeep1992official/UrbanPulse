# Reference only. Set these in your shell; these scripts do not auto-load .env.
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-user
MYSQL_PASSWORD=your-password
MYSQL_SSL_CA=certs/ca.pem
# Optional: absolute repository root and requested API record count
# URBANPULSE_ROOT=D:/Coding/UrbanPulse
# URBANPULSE_TARGET=100000
